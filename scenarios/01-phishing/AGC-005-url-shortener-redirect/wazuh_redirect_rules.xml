<!-- ==============================================================================
     Ashford Grove SOC - Scenario AGC-005: URL-Shortener Redirect Chain
     Investigating Analyst: Ali (TOOSHY2) | Detection Engineering Team
     Target: /var/ossec/etc/rules/local_rules.xml
     ============================================================================== -->

<group name="local,syslog,sshd,">

  <!-- AGC-005: Detect URL Shortener & Redirect Path Traversal on Endpoint -->
  <rule id="100006" level="10">
    <if_sid>60000</if_sid>
    <match>/go/|/r/|/link/|/click/|agc005-email</match>
    <description>Ashford Grove SOC (AGC-005): Suspicious URL shortener or redirect path accessed on endpoint</description>
    <mitre>
      <id>T1566.002</id>
    </mitre>
    <info type="link">https://github.com/TOOSHY2/Ashford-Grove-SOC</info>
  </rule>

  <!-- AGC-005: Correlate Shortener Redirection with External Phishing Sink Egress -->
  <rule id="100007" level="12">
    <if_sid>60000</if_sid>
    <field name="win.eventdata.destinationIp">^10\.10\.40\.10$</field>
    <description>Ashford Grove SOC (AGC-005): Outbound connection to external harvest infrastructure following redirect lure</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1056.003</id>
    </mitre>
    <info type="link">https://github.com/TOOSHY2/Ashford-Grove-SOC</info>
  </rule>

</group>
